# Self-hosted Supabase (Postgres 18 + PostgREST) on Railway — the bug-fix-automation DB.
# Lives in the dedicated "Kudzu HRM BFA Database" Railway project.
# The anon key is a fixed, non-secret string: this instance does not use JWT auth,
# every request runs as the Postgres `anon` role through the bfa_* RPCs.
VITE_SUPABASE_URL=https://api-proxy-production-4b00c5ab.up.railway.app
VITE_SUPABASE_ANON_KEY=self-hosted-mock-anon-key
VITE_DB_SCHEMA=bug_fix_automation_mock_prod
